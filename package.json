{
  "name": "guided-face-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Gefuehrte Videoaufnahme mit automatischer Extraktion standardisierter Gesichtspositionen - laeuft vollstaendig im Browser",
  "scripts": {
